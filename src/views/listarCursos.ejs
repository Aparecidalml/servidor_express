<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cursos</title>
</head>
<body>
    <h1>Cursos Disponíveis</h1>
    <% cursos.forEach(curso => { %>
        <div>
            Curso: <%= curso.curso %>
            <ul>
                <li>código: <%= curso.cod %></li>              
                <li>Carga Horária: <%= curso.ch %></li>
                <li>Tipo: <%= curso.tipo %></li>
            </ul>
        </div>
    <% }) %>
    
</body>
</html>