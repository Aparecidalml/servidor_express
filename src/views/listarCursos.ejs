<%- include('partials/header', {titulo: 'Cursos'}) %>

    <h1>Cursos Disponíveis</h1>
    <h3>
    <% cursos.forEach(curso => { %>
        <div>
            Curso: <%= curso.curso %>
            <ul>
                <li>código: <%= curso.cod %></li>              
                <li>Carga Horária: <%= curso.ch %></li>
                <li>Tipo: <%= curso.tipo %></li>
            </ul>
        </div>
    <% }) %>
    </h3>
    <br><br><br><br>
    <form action="/logout" method="post">
        <button type="submit"> SAIR </button>
    </form>

    <%- include('partials/footer') %>